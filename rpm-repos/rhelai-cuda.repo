[rhelai-3.6-cuda-for-rhel-9-x86_64-rpms]
name = Red Hat Enterprise Linux AI 3.6 CUDA for RHEL 9 - x86_64
baseurl = https://cdn.redhat.com/content/dist/layered/rhel9/x86_64/rhelai-cuda/3.6/os
enabled = 1
gpgcheck = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
sslverify = 1
sslcacert = /etc/rhsm/ca/redhat-uep.pem
sslclientkey = /etc/pki/entitlement/6833253378707343706-key.pem
sslclientcert = /etc/pki/entitlement/6833253378707343706.pem
sslverifystatus = 1
metadata_expire = 86400
enabled_metadata = 0

